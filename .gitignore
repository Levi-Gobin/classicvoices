# Only our own sources are published. Firmware, voices, generated engine code
# and build output stay on your machine (or in your own GitHub Actions run).
/*
!/.gitignore
!/.github/
!/core/
!/ios/
!/nvda/
!/tools/
!/tests/
!/third_party/
!/linux/
!/ports/
!/android/
!/windows/
!/desktop/
!/README.md
!/NOTES.md
!/LICENSE
!/classicvoices.sh
!/classicvoices.ps1

ios/*.xcodeproj/
.DS_Store
__pycache__/

nvda/addon/synthDrivers/_classicvoices/*.dll
