    <!-- settings -->
    <string name="speech">Speech</string>
    <string name="setting_rules">Apple\'s pronunciation rules</string>
    <string name="setting_rules_explained">The text rules each voice\'s own iOS or Mac OS X release applied before speaking: “iOS” is spelled out, “OS X” is “OS ten”, St and Dr become Street and Drive, and so on.</string>
    <string name="setting_newer_rules">Newer pronunciation rules</string>
    <string name="setting_newer_rules_explained">Apple\'s later pronunciation dictionary and rules, added to the voice\'s own. Turning this on downloads them from Apple for every language (about 5 MB).</string>
